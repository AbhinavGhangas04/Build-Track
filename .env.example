# Copy this to .env and fill in your values

# Neon PostgreSQL — paste your connection string from Neon dashboard
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-odd-moon-xxxxxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT secret — use any long random string (e.g. openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-this

# Cloudinary — sign up free at cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
